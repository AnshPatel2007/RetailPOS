{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "Point of sale for convenience, liquor and grocery stores",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "audit:interactions": "node scripts/inventory-interactions.cjs",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "retail",
    "inventory"
  ],
  "author": "POS System Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
