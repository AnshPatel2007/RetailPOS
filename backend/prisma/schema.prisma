generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String               @id @default(uuid())
  email                      String               @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       UserRole             @default(CASHIER)
  isActive                   Boolean              @default(true)
  locationId                 String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  lastLoginAt                DateTime?
  failedLoginAttempts        Int                  @default(0)
  lockoutUntil               DateTime?
  passwordResetExpires       DateTime?
  passwordResetToken         String?
  twoFactorBackupCodes       String[]             @default([])
  twoFactorEnabled           Boolean              @default(false)
  twoFactorSecret            String?
  activityLogs               ActivityLog[]
  expenses                   Expense[]
  refreshTokens              RefreshToken[]
  sales                      Sale[]
  shifts                     Shift[]
  location                   Location?            @relation(fields: [locationId], references: [id])
  recurringExpenses          RecurringExpense[]
  lotteryBatches             LotteryBatch[]
  lotteryTransactions        LotteryTransaction[]
  lotteryScans               LotteryTicketScan[]
  lotteryDailyEntriesCreated LotteryDailyEntry[]  @relation("DailyEntryCreator")
  lotteryDailyEntriesEdited  LotteryDailyEntry[]  @relation("DailyEntryEditor")
  lotteryDaysClosedBy        LotteryDayStatus[]   @relation("DayClosedBy")
  lotteryDaysReopenedBy      LotteryDayStatus[]   @relation("DayReopenedBy")

  @@index([email])
  @@index([locationId])
  @@index([passwordResetToken])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isRevoked  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Location {
  id                   String               @id @default(uuid())
  name                 String
  address              String
  city                 String
  state                String
  zipCode              String
  country              String               @default("US")
  phone                String
  email                String
  taxRate              Float                @default(0)
  cardSurchargePercent Float                @default(0) // card surcharge / cash-discount program (0 = off)
  isActive             Boolean              @default(true)
  businessHours        Json?
  settings             Json?
  currency             String               @default("USD")
  timezone             String               @default("America/New_York")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  expenses             Expense[]
  products             Product[]
  sales                Sale[]
  shifts               Shift[]
  users                User[]
  budgets              Budget[]
  recurringExpenses    RecurringExpense[]
  lotteryBatches       LotteryBatch[]
  lotteryTransactions  LotteryTransaction[]
  lotteryScans         LotteryTicketScan[]
  lotteryTicketTypes   LotteryTicketType[]
  lotteryDailyEntries  LotteryDailyEntry[]
  lotteryDayStatuses   LotteryDayStatus[]

  @@map("locations")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  color       String?
  icon        String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  locationId  String? // null = shared across all locations
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([locationId])
  @@map("categories")
}

model Product {
  id              String            @id @default(uuid())
  sku             String
  name            String
  description     String?
  categoryId      String?
  cost            Float             @default(0)
  price           Float
  compareAtPrice  Float?
  trackInventory  Boolean           @default(true)
  stockQuantity   Int               @default(0)
  lowStockAlert   Int               @default(10)
  barcode         String?
  image           String?
  images          Json?
  isActive        Boolean           @default(true)
  isTaxable       Boolean           @default(true)
  allowBackorder  Boolean           @default(false)
  minimumAge      Int? // age-restricted item (18/21) — checkout requires a logged verification
  ebtEligible     Boolean           @default(false) // SNAP/EBT-eligible; caps EBT tender server-side
  priceEmbedded   Boolean           @default(false) // sold via 2-prefix price-embedded barcodes (deli/scale)
  locationId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  inventoryLogs   InventoryLog[]
  suppliers       ProductSupplier[]
  variants        ProductVariant[]
  category        Category?         @relation(fields: [categoryId], references: [id])
  location        Location?         @relation(fields: [locationId], references: [id])
  saleItems       SaleItem[]
  transferItems   TransferItem[]
  cycleCountItems CycleCountItem[]

  @@unique([sku, locationId])
  @@unique([barcode, locationId])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([locationId])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String
  sku           String   @unique
  barcode       String?  @unique
  price         Float?
  cost          Float?
  stockQuantity Int      @default(0)
  options       Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model Supplier {
  id             String            @id @default(uuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  paymentTerms   String?
  leadTimeDays   Int?
  minimumOrder   Float?
  isActive       Boolean           @default(true)
  locationId     String? // null = shared across all locations
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@index([locationId])
  @@map("suppliers")
}

model ProductSupplier {
  id          String   @id @default(uuid())
  productId   String
  supplierId  String
  supplierSku String?
  cost        Float?
  leadTime    Int?
  minOrder    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  orderNumber String              @unique
  supplierId  String
  status      String              @default("PENDING")
  totalAmount Float               @default(0)
  notes       String?
  locationId  String? // null = shared across all locations
  orderedAt   DateTime?
  expectedAt  DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
  supplier    Supplier            @relation(fields: [supplierId], references: [id])

  @@index([locationId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  sku             String
  productName     String
  quantity        Int
  cost            Float
  total           Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model InventoryLog {
  id          String   @id @default(uuid())
  productId   String
  type        String
  quantity    Int
  previousQty Int
  newQty      Int
  notes       String?
  userId      String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model Sale {
  id             String        @id @default(uuid())
  saleNumber     String        @unique
  customerId     String?
  userId         String
  locationId     String?
  subtotal       Float         @default(0)
  tax            Float         @default(0)
  discount       Float         @default(0)
  surcharge      Float         @default(0) // card surcharge collected (included in total)
  total          Float         @default(0)
  paymentMethod  PaymentMethod
  amountPaid     Float         @default(0)
  changeDue      Float         @default(0)
  status         SaleStatus    @default(COMPLETED)
  notes          String?
  receiptNumber  String?
  receiptEmail   String?
  shiftId        String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?
  refundedAt     DateTime?
  refunds        Refund[]
  items          SaleItem[]
  payments       SalePayment[]
  customer       Customer?     @relation(fields: [customerId], references: [id])
  location       Location?     @relation(fields: [locationId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([saleNumber])
  @@index([customerId])
  @@index([userId])
  @@index([locationId])
  @@index([createdAt])
  @@index([shiftId])
  @@map("sales")
}

model SaleItem {
  id                String       @id @default(uuid())
  saleId            String
  productId         String
  sku               String
  productName       String
  quantity          Int          @default(1)
  price             Float
  discount          Float        @default(0)
  tax               Float        @default(0)
  total             Float
  notes             String?
  promotionId       String? // promotion applied to this line (denormalized — promo may be edited/deleted later)
  promotionName     String?
  promotionDiscount Float        @default(0) // portion of `discount` contributed by the promotion
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  product           Product      @relation(fields: [productId], references: [id])
  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refundItems       RefundItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id            String        @id @default(uuid())
  saleId        String
  paymentMethod PaymentMethod
  amount        Float
  reference     String?
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

model Refund {
  id         String       @id @default(uuid())
  saleId     String
  amount     Float
  reason     String
  notes      String?
  refundedBy String
  method     String? // CASH, CARD, GIFT_CARD, STORE_CREDIT — where the money went back to
  reference  String? // gift card code when method = GIFT_CARD
  createdAt  DateTime     @default(now())
  sale       Sale         @relation(fields: [saleId], references: [id])
  items      RefundItem[]

  @@index([saleId])
  @@map("refunds")
}

model RefundItem {
  id         String   @id @default(uuid())
  refundId   String
  saleItemId String
  quantity   Int
  amount     Float // portion of the refund attributable to this line
  restocked  Boolean  @default(true)
  createdAt  DateTime @default(now())
  refund     Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  @@index([refundId])
  @@index([saleItemId])
  @@map("refund_items")
}

model Customer {
  id                  String              @id @default(uuid())
  email               String?             @unique
  phone               String?             @unique
  firstName           String
  lastName            String
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  emailMarketing      Boolean             @default(false)
  smsMarketing        Boolean             @default(false)
  tags                String[]            @default([])
  birthDate           DateTime? // birthday perks (month/day is what matters)
  lastBirthdayEmailAt DateTime? // resend guard — one birthday email per year
  loyaltyPoints       Int                 @default(0)
  loyaltyTier         String              @default("BRONZE")
  totalSpent          Float               @default(0)
  visitCount          Int                 @default(0)
  notes               String?
  isActive            Boolean             @default(true)
  locationId          String? // null = shared across all locations
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastVisitAt         DateTime?
  sales               Sale[]
  giftCards           GiftCard[]
  storeCreditAccount  StoreCreditAccount?
  houseAccount        HouseAccount?

  @@index([email])
  @@index([phone])
  @@index([locationId])
  @@map("customers")
}

model GiftCard {
  id             String                @id @default(uuid())
  code           String                @unique
  initialBalance Float
  currentBalance Float
  isActive       Boolean               @default(true)
  expiresAt      DateTime?
  customerId     String?
  locationId     String? // issuing store; null = valid at all locations
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  customer       Customer?             @relation(fields: [customerId], references: [id])
  transactions   GiftCardTransaction[]

  @@index([code])
  @@index([customerId])
  @@index([locationId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id            String   @id @default(uuid())
  giftCardId    String
  type          String // ISSUE, RELOAD, REDEEM, REFUND
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  saleId        String?
  notes         String?
  createdAt     DateTime @default(now())
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@index([saleId])
  @@map("gift_card_transactions")
}

model StoreCreditAccount {
  id           String                   @id @default(uuid())
  customerId   String                   @unique
  balance      Float                    @default(0)
  locationId   String? // null = shared across all locations
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  customer     Customer                 @relation(fields: [customerId], references: [id])
  transactions StoreCreditTransaction[]

  @@index([locationId])
  @@map("store_credit_accounts")
}

model StoreCreditTransaction {
  id            String             @id @default(uuid())
  accountId     String
  type          String // CREDIT, DEBIT, REFUND
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  saleId        String?
  notes         String?
  createdAt     DateTime           @default(now())
  account       StoreCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([saleId])
  @@map("store_credit_transactions")
}

model HouseAccount {
  id           String                    @id @default(uuid())
  customerId   String                    @unique
  creditLimit  Float                     @default(0)
  balance      Float                     @default(0) // amount the customer currently owes
  isActive     Boolean                   @default(true)
  locationId   String? // null = shared across all locations
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  customer     Customer                  @relation(fields: [customerId], references: [id])
  transactions HouseAccountTransaction[]

  @@index([locationId])
  @@map("house_accounts")
}

model HouseAccountTransaction {
  id            String       @id @default(uuid())
  accountId     String
  type          String // CHARGE, PAYMENT, ADJUSTMENT
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  saleId        String?
  notes         String?
  userId        String?
  createdAt     DateTime     @default(now())
  account       HouseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([saleId])
  @@map("house_account_transactions")
}

model Exchange {
  id              String   @id @default(uuid())
  exchangeNumber  String   @unique
  originalSaleId  String
  newSaleId       String?
  type            String // RETURN_ONLY, EXCHANGE, RETURN_FOR_CREDIT
  status          String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  reason          String
  returnedItems   Json // [{productId, quantity, price}]
  priceDifference Float    @default(0)
  notes           String?
  processedBy     String
  locationId      String? // denormalized from the original sale's location
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([originalSaleId])
  @@index([exchangeNumber])
  @@index([locationId])
  @@map("exchanges")
}

model InventoryTransfer {
  id             String         @id @default(uuid())
  transferNumber String         @unique
  fromLocationId String
  toLocationId   String
  status         String         @default("PENDING") // PENDING, IN_TRANSIT, RECEIVED, CANCELLED
  notes          String?
  createdBy      String
  shippedAt      DateTime?
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          TransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@map("inventory_transfers")
}

model TransferItem {
  id          String            @id @default(uuid())
  transferId  String
  productId   String
  quantity    Int
  receivedQty Int               @default(0)
  createdAt   DateTime          @default(now())
  transfer    InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

model CycleCount {
  id          String           @id @default(uuid())
  countNumber String           @unique
  locationId  String
  status      String           @default("IN_PROGRESS") // IN_PROGRESS, REVIEW, APPROVED, CANCELLED
  type        String           @default("FULL") // FULL, PARTIAL, CATEGORY
  categoryId  String?
  notes       String?
  createdBy   String
  approvedBy  String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CycleCountItem[]

  @@index([locationId])
  @@index([status])
  @@map("cycle_counts")
}

model CycleCountItem {
  id           String     @id @default(uuid())
  cycleCountId String
  productId    String
  expectedQty  Int
  countedQty   Int?
  discrepancy  Int?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cycleCount   CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@index([cycleCountId])
  @@index([productId])
  @@map("cycle_count_items")
}

model Shift {
  id                String         @id @default(uuid())
  userId            String
  locationId        String?
  clockInAt         DateTime
  clockOutAt        DateTime?
  startingCash      Float          @default(0)
  endingCash        Float?
  expectedCash      Float?
  cashDifference    Float?
  totalSales        Float          @default(0)
  totalTransactions Int            @default(0)
  isClosed          Boolean        @default(false)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sales             Sale[]
  cashMovements     CashMovement[]
  location          Location?      @relation(fields: [locationId], references: [id])
  user              User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([locationId])
  @@index([clockInAt])
  @@map("shifts")
}

model CashMovement {
  id        String   @id @default(uuid())
  shiftId   String
  type      String // SAFE_DROP, PAID_IN, PAID_OUT
  amount    Float
  reason    String
  userId    String
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("cash_movements")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  locationId String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Expense {
  id            String          @id @default(uuid())
  expenseNumber String          @unique
  category      ExpenseCategory
  description   String
  amount        Float
  status        ExpenseStatus   @default(PENDING)
  vendor        String?
  receiptUrl    String?
  invoiceNumber String?
  expenseDate   DateTime        @default(now())
  dueDate       DateTime?
  paidDate      DateTime?
  locationId    String?
  userId        String
  approvedBy    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  location      Location?       @relation(fields: [locationId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([status])
  @@index([expenseDate])
  @@index([locationId])
  @@index([userId])
  @@map("expenses")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique // SHA-256 of the key — the key itself is shown once
  prefix     String // first characters, for display ("pos_a1b2…")
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@map("api_keys")
}

model WebhookEndpoint {
  id             String    @id @default(uuid())
  url            String
  events         String[]  @default([]) // sale.completed, sale.refunded, product.low_stock
  secret         String // HMAC signing secret (whsec_…) — kept to sign payloads
  isActive       Boolean   @default(true)
  failCount      Int       @default(0) // consecutive failures; auto-disabled at 20
  lastStatus     Int?
  lastDeliveryAt DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  @@map("webhook_endpoints")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Discount {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  type        String
  value       Float
  minPurchase Float?
  maxDiscount Float?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  usageLimit  Int?
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("discounts")
}

model AgeVerificationLog {
  id           String    @id @default(uuid())
  saleId       String? // linked once the sale completes
  userId       String // cashier who performed the check
  locationId   String?
  minimumAge   Int // the strictest age requirement in the cart
  method       String // ID_SCAN, MANUAL_DOB, VISUAL
  birthDate    DateTime? // captured for ID_SCAN / MANUAL_DOB
  productNames String[]  @default([]) // restricted items in the cart at check time
  approved     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([saleId])
  @@map("age_verification_logs")
}

model Promotion {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        PromotionType
  isActive    Boolean       @default(true)
  // Rule parameters (which ones apply depends on `type`)
  buyQuantity Int? // QUANTITY_PRICE: units per bundle; BOGO: paid units
  getQuantity Int? // BOGO: discounted units per group
  bundlePrice Float? // QUANTITY_PRICE: total price for buyQuantity units
  percentOff  Float? // BOGO (default 100 = free) and PERCENT_OFF
  amountOff   Float? // AMOUNT_OFF: $ off per unit
  // Targeting — a unit is eligible if its product OR category is listed (mix-and-match group)
  productIds  String[]      @default([])
  categoryIds String[]      @default([])
  // Schedule
  startsAt    DateTime?
  endsAt      DateTime?
  daysOfWeek  Int[]         @default([]) // 0=Sun..6=Sat, empty = every day
  startTime   String? // "HH:MM" store-local, with endTime enables happy-hour windows
  endTime     String?
  locationId  String? // null = all locations
  priority    Int           @default(0) // higher wins when units qualify for several promos
  timesUsed   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive])
  @@index([locationId])
  @@map("promotions")
}

model Budget {
  id         String          @id @default(uuid())
  category   ExpenseCategory
  amount     Float
  period     BudgetPeriod    @default(MONTHLY)
  startDate  DateTime
  endDate    DateTime?
  locationId String?
  isActive   Boolean         @default(true)
  alertAt    Float? // Alert when spending reaches this percentage (e.g., 80)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  location   Location?       @relation(fields: [locationId], references: [id])

  @@unique([category, period, startDate, locationId])
  @@index([category])
  @@index([locationId])
  @@map("budgets")
}

model RecurringExpense {
  id            String             @id @default(uuid())
  description   String
  category      ExpenseCategory
  amount        Float
  vendor        String?
  frequency     RecurringFrequency
  dayOfMonth    Int? // For MONTHLY: which day (1-31)
  dayOfWeek     Int? // For WEEKLY: which day (0-6)
  startDate     DateTime
  endDate       DateTime?
  nextDueDate   DateTime
  locationId    String?
  userId        String
  isActive      Boolean            @default(true)
  lastGenerated DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  location      Location?          @relation(fields: [locationId], references: [id])
  user          User               @relation(fields: [userId], references: [id])

  @@index([nextDueDate])
  @@index([category])
  @@index([locationId])
  @@map("recurring_expenses")
}

model AccountingExport {
  id          String     @id @default(uuid())
  type        ExportType
  format      String // CSV, QBO, XLS
  startDate   DateTime
  endDate     DateTime
  status      String     @default("COMPLETED")
  fileUrl     String?
  recordCount Int        @default(0)
  userId      String
  createdAt   DateTime   @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("accounting_exports")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  GIFT_CARD
  STORE_CREDIT
  EBT
  HOUSE_ACCOUNT
  OTHER
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
  VOIDED
  HOLD
}

enum ExpenseCategory {
  UTILITIES
  RENT
  PAYROLL
  SUPPLIES
  INVENTORY_PURCHASE
  MARKETING
  MAINTENANCE
  INSURANCE
  TAXES
  SHIPPING
  SOFTWARE
  EQUIPMENT
  OTHER
}

enum PromotionType {
  QUANTITY_PRICE // N for $X (2 for $6.00)
  BOGO // buy N get M at percentOff (100 = free)
  PERCENT_OFF // % off every eligible unit
  AMOUNT_OFF // $ off every eligible unit
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ExportType {
  SALES
  EXPENSES
  INVENTORY
  CUSTOMERS
  JOURNAL_ENTRIES
}

enum LotteryBatchStatus {
  ACTIVE
  DEPLETED
  RETURNED
}

enum LotteryTransactionStatus {
  OPEN
  CLOSED
}

model LotteryBatch {
  id               String              @id @default(uuid())
  batchNumber      String
  gameType         String
  startTicketNum   String
  endTicketNum     String
  totalTickets     Int
  remainingTickets Int
  pricePerTicket   Float
  status           LotteryBatchStatus  @default(ACTIVE)
  activatedAt      DateTime?
  depletedAt       DateTime?
  notes            String?
  userId           String
  locationId       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id])
  location         Location?           @relation(fields: [locationId], references: [id])
  scans            LotteryTicketScan[]

  @@index([locationId])
  @@index([batchNumber])
  @@map("lottery_batches")
}

model LotteryTransaction {
  id                 String                   @id @default(uuid())
  transactionDate    DateTime
  onlineSalesCount   Int                      @default(0)
  onlineSalesAmount  Float                    @default(0)
  offlineSalesCount  Int                      @default(0)
  offlineSalesAmount Float                    @default(0)
  cashoutAmount      Float                    @default(0)
  netAmount          Float                    @default(0)
  status             LotteryTransactionStatus @default(OPEN)
  closedAt           DateTime?
  closedBy           String?
  notes              String?
  userId             String
  locationId         String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id])
  location           Location?                @relation(fields: [locationId], references: [id])
  scans              LotteryTicketScan[]

  @@unique([transactionDate, locationId], name: "transactionDate_locationId")
  @@index([locationId])
  @@index([transactionDate])
  @@map("lottery_transactions")
}

model LotteryTicketScan {
  id            String              @id @default(uuid())
  barcode       String
  ticketNumber  String?
  gameType      String?
  amount        Float?
  notes         String?
  batchId       String?
  transactionId String?
  userId        String
  locationId    String?
  scannedAt     DateTime            @default(now())
  createdAt     DateTime            @default(now())
  batch         LotteryBatch?       @relation(fields: [batchId], references: [id])
  transaction   LotteryTransaction? @relation(fields: [transactionId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  location      Location?           @relation(fields: [locationId], references: [id])

  @@index([batchId])
  @@index([transactionId])
  @@index([locationId])
  @@index([scannedAt])
  @@map("lottery_ticket_scans")
}

model LotteryTicketType {
  id             String              @id @default(uuid())
  ticketName     String
  ticketCode     String
  pricePerTicket Float
  sortOrder      Int                 @default(0)
  isActive       Boolean             @default(true)
  locationId     String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  location       Location            @relation(fields: [locationId], references: [id])
  dailyEntries   LotteryDailyEntry[]

  @@index([locationId])
  @@index([ticketCode])
  @@map("lottery_ticket_types")
}

model LotteryDailyEntry {
  id             String            @id @default(uuid())
  entryDate      DateTime
  ticketTypeId   String
  locationId     String
  startNumber    Int
  endNumber      Int
  pricePerTicket Float
  ticketsSold    Int               @default(0)
  totalSales     Float             @default(0)
  notes          String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  ticketType     LotteryTicketType @relation(fields: [ticketTypeId], references: [id])
  location       Location          @relation(fields: [locationId], references: [id])
  creator        User?             @relation("DailyEntryCreator", fields: [createdBy], references: [id])
  editor         User?             @relation("DailyEntryEditor", fields: [updatedBy], references: [id])

  @@index([entryDate])
  @@index([ticketTypeId])
  @@index([locationId])
  @@map("lottery_daily_entries")
}

model LotteryDayStatus {
  id                  String    @id @default(uuid())
  entryDate           DateTime
  locationId          String
  totalTicketsSold    Int       @default(0)
  totalSales          Float     @default(0)
  manualCashoutAmount Float     @default(0)
  netAmount           Float     @default(0)
  status              String    @default("OPEN")
  isClosed            Boolean   @default(false)
  closedAt            DateTime?
  closedBy            String?
  reopenedAt          DateTime?
  reopenedBy          String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  location            Location  @relation(fields: [locationId], references: [id])
  closedByUser        User?     @relation("DayClosedBy", fields: [closedBy], references: [id])
  reopenedByUser      User?     @relation("DayReopenedBy", fields: [reopenedBy], references: [id])

  @@index([entryDate])
  @@index([locationId])
  @@map("lottery_day_statuses")
}
