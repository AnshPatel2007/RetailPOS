generator client {
  provider = "prisma-client-js"
}

// Inventory cost facts are append-only. Balances are their current projection.
model InventoryValuation {
  productId String @id
  locationId String
  quantity Int
  value Decimal? @db.Decimal(24, 8)
  // Last trustworthy average or receipt unit cost; values shortfalls when
  // recorded stock runs out (provisional COGS, flagged ESTIMATED).
  lastUnitCost Decimal? @db.Decimal(24, 8)
  lastEntryId String?
  verifiedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([locationId])
  @@map("inventory_valuations")
}

model InventoryValueEntry {
  id String @id @default(uuid())
  sequence Int @unique @default(autoincrement())
  productId String
  locationId String
  userId String
  kind String
  mode String
  sourceId String
  sourceKey String @unique
  quantity Int
  quantityBefore Int
  quantityAfter Int
  inputValue Decimal? @db.Decimal(24, 8)
  valueBefore Decimal? @db.Decimal(24, 8)
  valueChange Decimal? @db.Decimal(24, 8)
  valueAfter Decimal? @db.Decimal(24, 8)
  cogsAmount Decimal? @db.Decimal(24, 8)
  costStatus CostStatus @default(VERIFIED)
  // Value of units added without a delivery record (filled a negative balance
  // or a delivery that was never entered). Listed for supplier-invoice matching.
  unmatchedValue Decimal? @db.Decimal(24, 8)
  referenceEntryId String?
  referenceQuantity Int?
  referenceOffset Int @default(0)
  // Why the stock changed (DAMAGED, EXPIRED, THEFT, COUNT_DIFFERENCE, ...). Null on rows
  // written before this column existed and on movements that need no cause (sales, receipts).
  reason String?
  notes String?
  effectiveAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([locationId, createdAt, sequence])
  @@index([productId, sequence])
  @@index([referenceEntryId])
  @@index([sourceId])
  @@map("inventory_value_entries")
}

model InventoryCostCorrection {
  id String @id @default(uuid())
  locationId String
  userId String
  sourceEntryId String
  inputValue Decimal @db.Decimal(24, 8)
  reason String
  idempotencyKey String @unique
  requestHash String
  preview Json
  // RESTATED: fills a missing cost in its original period (never finalized).
  // CURRENT_PERIOD: changes an already-booked cost; the difference posts as a
  // COST_CORRECTION entry when confirmed and past reports stay unchanged.
  recognition String @default("RESTATED")
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
  @@map("inventory_cost_corrections")
}

model InventoryCostRevision {
  id String @id @default(uuid())
  sequence Int @unique @default(autoincrement())
  correctionId String
  entryId String
  inputValue Decimal? @db.Decimal(24, 8)
  valueBefore Decimal? @db.Decimal(24, 8)
  valueChange Decimal? @db.Decimal(24, 8)
  valueAfter Decimal? @db.Decimal(24, 8)
  cogsAmount Decimal? @db.Decimal(24, 8)
  createdAt DateTime @default(now())
  @@unique([correctionId, entryId])
  @@index([entryId, sequence])
  @@map("inventory_cost_revisions")
}

model SupplierReturn {
  id String @id @default(uuid())
  locationId String
  userId String
  receiptEntryId String
  productId String
  quantity Int
  creditAmount Decimal @db.Decimal(14, 2)
  carryingValue Decimal? @db.Decimal(24, 8)
  costAdjustment Decimal? @db.Decimal(24, 8)
  reason String
  idempotencyKey String @unique
  requestHash String
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
  @@index([receiptEntryId])
  @@map("supplier_returns")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  operationReceipts OperationReceipt[]
  emailDeliveries EmailDelivery[]
  hourlyRate                 Decimal? @db.Decimal(14, 4)
  payrollEntries             PayrollEntry[]
  id                         String               @id @default(uuid())
  email                      String               @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       UserRole             @default(CASHIER)
  isActive                   Boolean              @default(true)
  locationId                 String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  lastLoginAt                DateTime?
  failedLoginAttempts        Int                  @default(0)
  lockoutUntil               DateTime?
  passwordResetExpires       DateTime?
  passwordResetToken         String?
  twoFactorBackupCodes       String[]             @default([])
  twoFactorEnabled           Boolean              @default(false)
  twoFactorSecret            String?
  twoFactorSetupSecret       String?
  twoFactorSetupExpires      DateTime?
  twoFactorLastStep           Int?
  twoFactorVersion            Int                  @default(0)
  /// Register PIN (bcrypt). PIN failures lock PIN sign-in only, never the password.
  pinHash                    String?
  pinSetAt                   DateTime?
  pinFailedAttempts          Int                  @default(0)
  pinLockoutUntil            DateTime?
  registerDevicesCreated     RegisterDevice[]     @relation("RegisterDeviceCreator")
  activityLogs               ActivityLog[]
  expenses                   Expense[]
  refreshTokens              RefreshToken[]
  sales                      Sale[]
  shifts                     Shift[]
  drawerEntries              DrawerEntry[]
  accountOperations          AccountOperation[]
  location                   Location?            @relation(fields: [locationId], references: [id])
  recurringExpenses          RecurringExpense[]
  lotteryBatches             LotteryBatch[]
  lotteryTransactions        LotteryTransaction[]
  lotteryScans               LotteryTicketScan[]
  lotteryDailyEntriesCreated LotteryDailyEntry[]  @relation("DailyEntryCreator")
  lotteryDailyEntriesEdited  LotteryDailyEntry[]  @relation("DailyEntryEditor")
  lotteryDaysClosedBy        LotteryDayStatus[]   @relation("DayClosedBy")
  lotteryDaysReopenedBy      LotteryDayStatus[]   @relation("DayReopenedBy")

  @@index([email])
  @@index([locationId])
  @@index([passwordResetToken])
  @@map("users")
}

model OperationReceipt {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  kind           String
  targetId       String
  userId         String
  locationId     String
  requestHash    String
  result         Json
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([locationId, kind, createdAt, id], map: "operation_receipts_scope_idx")
  @@index([targetId], map: "operation_receipts_target_idx")
  @@map("operation_receipts")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  isRevoked  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// A computer a manager has set up as a register: staff there sign in with name + PIN.
/// Only a SHA-256 hash of the register's secret is stored.
model RegisterDevice {
  id          String    @id @default(uuid())
  locationId  String
  name        String
  tokenHash   String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("RegisterDeviceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@map("register_devices")
}

model Location {
  registerDevices RegisterDevice[]
  costingActivatedAt DateTime?
  historicalIncome HistoricalIncome[]
  operationReceipts OperationReceipt[]
  emailDeliveries      EmailDelivery[]
  payrollFrequency     String               @default("WEEKLY")
  payrollEntries       PayrollEntry[]
  connectionsA         StoreConnection[]    @relation("ConnectionA")
  connectionsB         StoreConnection[]    @relation("ConnectionB")
  id                   String               @id @default(uuid())
  name                 String
  address              String
  city                 String
  state                String
  zipCode              String
  country              String               @default("US")
  phone                String
  email                String
  taxRate              Decimal @db.Decimal(9, 4)                @default(0)
  cardSurchargePercent Decimal @db.Decimal(9, 4)                @default(0) // card surcharge / cash-discount program (0 = off)
  isActive             Boolean              @default(true)
  businessHours        Json?
  settings             Json?
  currency             String               @default("USD")
  timezone             String               @default("America/New_York")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  expenses             Expense[]
  products             Product[]
  sales                Sale[]
  shifts               Shift[]
  drawerEntries        DrawerEntry[]
  accountOperations    AccountOperation[]
  users                User[]
  budgets              Budget[]
  recurringExpenses    RecurringExpense[]
  lotteryBatches       LotteryBatch[]
  lotteryTransactions  LotteryTransaction[]
  lotteryScans         LotteryTicketScan[]
  lotteryTicketTypes   LotteryTicketType[]
  lotteryDailyEntries  LotteryDailyEntry[]
  lotteryDayStatuses   LotteryDayStatus[]

  @@map("locations")
}

model HistoricalIncome {
  id String @id @default(uuid())
  locationId String
  sourceKey String @unique
  period String
  kind String
  amount Decimal @db.Decimal(14, 2)
  recognizedAt DateTime
  notes String
  createdAt DateTime @default(now())
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([locationId, recognizedAt])
  @@map("historical_income")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  color       String?
  icon        String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  locationId  String? // null = shared across all locations
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([locationId])
  @@map("categories")
}

model Product {
  baseUnitName    String            @default("unit")
  sellingUnits    ProductSellingUnit[]
  // Variety packs: what this pack contains, and the packs this product comes in.
  bundleComponents  ProductBundleComponent[] @relation("BundleContents")
  bundleMemberships ProductBundleComponent[] @relation("BundleMembership")
  verifiedUnitCost Decimal? @db.Decimal(24, 8)
  // Owner-authorized fallback cost for sales beyond recorded stock when no
  // receipt or average cost exists yet.
  provisionalUnitCost Decimal? @db.Decimal(14, 4)
  // Recall / prohibited-sale hold. Recorded stock never blocks a sale; this does.
  saleBlockedReason String?
  // Structured attributes used to suggest related SKUs when stock goes negative.
  brand String?
  productFamily String?
  variant String?
  size String?
  inventoryExceptions InventoryException[]
  id              String            @id @default(uuid())
  sku             String
  name            String
  description     String?
  categoryId      String?
  cost            Decimal @db.Decimal(14, 4)             @default(0)
  price           Decimal @db.Decimal(14, 4)
  compareAtPrice  Decimal? @db.Decimal(14, 4)
  trackInventory  Boolean           @default(true)
  stockQuantity   Int               @default(0)
  stockVersion    Int               @default(0)
  lowStockAlert   Int               @default(10)
  barcode         String?
  image           String?
  images          Json?
  isActive        Boolean           @default(true)
  isTaxable       Boolean           @default(true)
  allowBackorder  Boolean           @default(false)
  minimumAge      Int? // age-restricted item (18/21) — checkout requires a logged verification
  ebtEligible     Boolean           @default(false) // SNAP/EBT-eligible; caps EBT tender server-side
  priceEmbedded   Boolean           @default(false) // sold via 2-prefix price-embedded barcodes (deli/scale)
  locationId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  inventoryLogs   InventoryLog[]
  suppliers       ProductSupplier[]
  variants        ProductVariant[]
  category        Category?         @relation(fields: [categoryId], references: [id])
  location        Location?         @relation(fields: [locationId], references: [id])
  saleItems       SaleItem[]
  transferItems   TransferItem[]
  destinationTransferItems TransferItem[] @relation("TransferDestination")
  cycleCountItems CycleCountItem[]

  @@unique([sku, locationId])
  @@unique([barcode, locationId])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([locationId])
  @@index([locationId, productFamily])
  @@index([locationId, brand])
  @@map("products")
}

model ProductSellingUnit {
  id String @id @default(uuid())
  productId String
  locationId String
  name String
  sku String?
  barcode String
  price Decimal @db.Decimal(14, 4)
  unitsPerPackage Int
  sealedQuantity Int @default(0)
  isActive Boolean @default(true)
  version Int @default(0)
  createRequestKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([barcode, locationId], map: "product_selling_units_barcode_location_key")
  @@unique([sku, locationId], map: "product_selling_units_sku_location_key")
  @@unique([createRequestKey, locationId], map: "product_selling_units_request_location_key")
  @@index([productId], map: "product_selling_units_product_idx")
  @@index([locationId], map: "product_selling_units_location_idx")
  @@map("product_selling_units")
}

model ProductPackagingEvent {
  id String @id @default(uuid())
  productId String
  sellingUnitId String
  locationId String
  userId String
  kind String
  quantity Int
  previousQuantity Int
  newQuantity Int
  sourceId String?
  requestKey String?
  notes String?
  createdAt DateTime @default(now())
  @@unique([locationId, requestKey], map: "product_packaging_events_location_request_key")
  @@index([productId, createdAt], map: "product_packaging_events_product_created_idx")
  @@map("product_packaging_events")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String
  sku           String   @unique
  barcode       String?  @unique
  price         Decimal? @db.Decimal(14, 4)
  cost          Decimal? @db.Decimal(14, 4)
  stockQuantity Int      @default(0)
  options       Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model Supplier {
  id             String            @id @default(uuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  paymentTerms   String?
  leadTimeDays   Int?
  minimumOrder   Decimal? @db.Decimal(14, 4)
  isActive       Boolean           @default(true)
  locationId     String? // null = shared across all locations
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@index([locationId])
  @@map("suppliers")
}

model ProductSupplier {
  id          String   @id @default(uuid())
  productId   String
  supplierId  String
  supplierSku String?
  cost        Decimal? @db.Decimal(14, 4)
  leadTime    Int?
  minOrder    Int?
  // How the supplier sells it: a case of `packSize` base units for `packCost`.
  // `cost` stays the per-unit cost (packCost / packSize when a case is set).
  packSize    Int      @default(1)
  packCost    Decimal? @db.Decimal(14, 4)
  packBarcode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  orderNumber String              @unique
  supplierId  String
  status      String              @default("PENDING")
  totalAmount Decimal @db.Decimal(14, 2)               @default(0)
  notes       String?
  locationId  String? // null = shared across all locations
  orderedAt   DateTime?
  expectedAt  DateTime?
  receivedAt  DateTime?
  receivingHistoryKnown Boolean @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
  receipts    PurchaseReceipt[]
  supplier    Supplier            @relation(fields: [supplierId], references: [id])

  @@index([locationId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  sku             String
  productName     String
  quantity        Int
  receivedQty     Int           @default(0)
  damagedQty      Int           @default(0)
  rejectedQty     Int           @default(0)
  cost            Decimal @db.Decimal(14, 4)
  total           Decimal @db.Decimal(14, 2)
  // Ordered in supplier cases: quantity (base units) = packQuantity x packSize;
  // cost stays per base unit, packCost is the price of one case.
  packSize        Int           @default(1)
  packQuantity    Int?
  packCost        Decimal? @db.Decimal(14, 4)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiptItems    PurchaseReceiptItem[]

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  invoiceNumber String?
  invoiceDate DateTime?
  freight Decimal @default(0) @db.Decimal(14, 2)
  acquisitionTax Decimal @default(0) @db.Decimal(14, 2)
  invoiceDiscount Decimal @default(0) @db.Decimal(14, 2)
  id              String                @id @default(uuid())
  purchaseOrderId String
  idempotencyKey  String
  requestHash     String
  receivedBy      String
  notes           String?
  finalDelivery   Boolean               @default(false)
  createdAt       DateTime              @default(now())
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  items           PurchaseReceiptItem[]

  @@unique([purchaseOrderId, idempotencyKey])
  @@index([purchaseOrderId, createdAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  sellingUnitId String?
  sellingUnitName String?
  receivedPackageQuantity Int @default(0)
  unitCost Decimal? @db.Decimal(24, 8)
  packSize Int @default(1)
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  allocatedCharges Decimal @default(0) @db.Decimal(14, 2)
  inventoryValue Decimal? @db.Decimal(24, 8)
  inventoryEntryId String? @unique
  id                  String            @id @default(uuid())
  receiptId           String
  purchaseOrderItemId String
  acceptedQty         Int
  damagedQty          Int               @default(0)
  rejectedQty         Int               @default(0)
  receipt             PurchaseReceipt   @relation(fields: [receiptId], references: [id])
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([receiptId])
  @@index([purchaseOrderItemId])
  @@map("purchase_receipt_items")
}

model InventoryImport {
  id          String   @id @default(uuid())
  locationId  String
  userId      String
  kind        String
  payload     Json
  preview     Json
  result      Json?
  expiresAt   DateTime
  appliedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([locationId, userId, createdAt])
  @@map("inventory_imports")
}

model InventoryLog {
  id          String   @id @default(uuid())
  productId   String
  type        String
  quantity    Int
  previousQty Int
  newQty      Int
  notes       String?
  userId      String?
  locationId  String?
  sourceId    String?
  stockVersion Int?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model Sale {
  sourceType String @default("RECEIPT")
  sourceData Json?
  pricingVersion Int?
  pointsEarned Int?
  pointsRedeemed Int?
  loyaltyDiscount Decimal? @db.Decimal(14, 2)
  id             String        @id @default(uuid())
  saleNumber     String        @unique
  customerId     String?
  userId         String
  locationId     String?
  subtotal       Decimal @db.Decimal(14, 2)         @default(0)
  tax            Decimal @db.Decimal(14, 2)         @default(0)
  discount       Decimal @db.Decimal(14, 2)         @default(0)
  surcharge      Decimal @db.Decimal(14, 2)         @default(0) // card surcharge collected (included in total)
  total          Decimal @db.Decimal(14, 2)         @default(0)
  paymentMethod  PaymentMethod
  amountPaid     Decimal @db.Decimal(14, 2)         @default(0)
  changeDue      Decimal @db.Decimal(14, 2)         @default(0)
  status         SaleStatus    @default(COMPLETED)
  notes          String?
  receiptNumber  String?
  receiptEmail   String?
  shiftId        String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?
  refundedAt     DateTime?
  refunds        Refund[]
  voidEvent      SaleVoid?
  drawerEntries  DrawerEntry[]
  items          SaleItem[]
  payments       SalePayment[]
  customer       Customer?     @relation(fields: [customerId], references: [id])
  location       Location?     @relation(fields: [locationId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([saleNumber])
  @@index([customerId])
  @@index([userId])
  @@index([locationId])
  @@index([createdAt])
  @@index([shiftId])
  @@map("sales")
}

model SaleVoid {
  id             String   @id @default(uuid())
  saleId         String   @unique
  locationId     String
  userId         String
  approvalId     String?
  shiftId        String?
  reason         String
  amount         Decimal  @db.Decimal(14, 2)
  taxAmount      Decimal  @db.Decimal(14, 2)
  discount       Decimal  @db.Decimal(14, 2)
  costReversed   Decimal? @db.Decimal(24, 8)
  pointsRestored Int?
  pointsReversed Int?
  items          Json
  tenders        Json
  idempotencyKey String?  @unique
  requestHash    String
  createdAt      DateTime @default(now())
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([locationId, createdAt])
  @@map("sale_voids")
}

model SaleItem {
  sellingUnitId String?
  unitsPerPackage Int @default(1)
  inventoryQuantity Int?
  costAmount Decimal? @db.Decimal(24, 8)
  costStatus CostStatus @default(VERIFIED)
  inventoryEntryId String? @unique
  unitCost Decimal? @db.Decimal(14, 4)
  taxRate Decimal? @db.Decimal(9, 4)
  taxTreatment String?
  manualDiscount Decimal? @db.Decimal(14, 2)
  loyaltyDiscount Decimal? @db.Decimal(14, 2)
  surcharge Decimal? @db.Decimal(14, 2)
  pointsEarned Int?
  pointsRedeemed Int?
  id                String       @id @default(uuid())
  saleId            String
  productId         String
  sku               String
  productName       String
  quantity          Int          @default(1)
  price             Decimal @db.Decimal(14, 4)
  discount          Decimal @db.Decimal(14, 2)        @default(0)
  tax               Decimal @db.Decimal(14, 2)        @default(0)
  total             Decimal @db.Decimal(14, 2)
  notes             String?
  promotionId       String? // promotion applied to this line (denormalized — promo may be edited/deleted later)
  promotionName     String?
  promotionDiscount Decimal @db.Decimal(14, 2)        @default(0) // portion of `discount` contributed by the promotion
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  product           Product      @relation(fields: [productId], references: [id])
  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refundItems       RefundItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id            String        @id @default(uuid())
  saleId        String
  paymentMethod PaymentMethod
  amount        Decimal @db.Decimal(14, 2)
  reference     String?
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

model Refund {
  tenders Json? // Original payment source and actual payout allocations; null for legacy history.
  pointsRestored Int?
  pointsReversed Int?
  taxAmount Decimal? @db.Decimal(14, 2)
  id         String       @id @default(uuid())
  saleId     String
  amount     Decimal @db.Decimal(14, 2)
  reason     String
  notes      String?
  refundedBy String
  method     String? // CASH, CARD, GIFT_CARD, STORE_CREDIT — where the money went back to
  reference  String? // gift card code when method = GIFT_CARD
  idempotencyKey String? @unique
  requestHash    String?
  drawerEntries  DrawerEntry[]
  createdAt  DateTime     @default(now())
  sale       Sale         @relation(fields: [saleId], references: [id])
  items      RefundItem[]

  @@index([saleId])
  @@map("refunds")
}

model RefundItem {
  restockedAsSealed Boolean @default(false)
  pointsRestored Int?
  pointsReversed Int?
  taxAmount Decimal? @db.Decimal(14, 2)
  costReturned Decimal? @db.Decimal(24, 8)
  id         String   @id @default(uuid())
  refundId   String
  saleItemId String
  quantity   Int
  amount     Decimal @db.Decimal(14, 2) // portion of the refund attributable to this line
  restocked  Boolean  @default(true)
  createdAt  DateTime @default(now())
  refund     Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  @@index([refundId])
  @@index([saleItemId])
  @@map("refund_items")
}

model Customer {
  id                  String              @id @default(uuid())
  // Customers belong to one store: an email or phone is unique within its store,
  // so the same person can be a customer of two stores.
  email               String?
  phone               String?
  firstName           String
  lastName            String
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  emailMarketing      Boolean             @default(false)
  smsMarketing        Boolean             @default(false)
  tags                String[]            @default([])
  birthDate           DateTime? // birthday perks (month/day is what matters)
  lastBirthdayEmailAt DateTime? // resend guard — one birthday email per year
  loyaltyPoints       Int                 @default(0)
  loyaltyTier         String              @default("BRONZE")
  totalSpent          Decimal @db.Decimal(14, 2)               @default(0)
  visitCount          Int                 @default(0)
  notes               String?
  isActive            Boolean             @default(true)
  locationId          String? // null = shared across all locations
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastVisitAt         DateTime?
  sales               Sale[]
  giftCards           GiftCard[]
  storeCreditAccount  StoreCreditAccount?
  houseAccount        HouseAccount?

  @@unique([email, locationId])
  @@unique([phone, locationId])
  @@index([email])
  @@index([phone])
  @@index([locationId])
  @@map("customers")
}

model GiftCard {
  id             String                @id @default(uuid())
  code           String                @unique
  initialBalance Decimal @db.Decimal(14, 2)
  currentBalance Decimal @db.Decimal(14, 2)
  isActive       Boolean               @default(true)
  expiresAt      DateTime?
  customerId     String?
  locationId     String? // issuing store; null = valid at all locations
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  customer       Customer?             @relation(fields: [customerId], references: [id])
  transactions   GiftCardTransaction[]
  operations     AccountOperation[]

  @@index([code])
  @@index([customerId])
  @@index([locationId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id            String   @id @default(uuid())
  giftCardId    String
  type          String // ISSUE, RELOAD, REDEEM, REFUND
  amount        Decimal @db.Decimal(14, 2)
  balanceBefore Decimal @db.Decimal(14, 2)
  balanceAfter  Decimal @db.Decimal(14, 2)
  saleId        String?
  notes         String?
  createdAt     DateTime @default(now())
  operationId   String? @unique
  operation     AccountOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Restrict)

  @@index([giftCardId])
  @@index([saleId])
  @@map("gift_card_transactions")
}

model StoreCreditAccount {
  id           String                   @id @default(uuid())
  customerId   String                   @unique
  balance      Decimal @db.Decimal(14, 2)                    @default(0)
  locationId   String? // null = shared across all locations
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  customer     Customer                 @relation(fields: [customerId], references: [id])
  transactions StoreCreditTransaction[]
  operations   AccountOperation[]

  @@index([locationId])
  @@map("store_credit_accounts")
}

model StoreCreditTransaction {
  id            String             @id @default(uuid())
  accountId     String
  type          String // CREDIT, DEBIT, REFUND
  amount        Decimal @db.Decimal(14, 2)
  balanceBefore Decimal @db.Decimal(14, 2)
  balanceAfter  Decimal @db.Decimal(14, 2)
  saleId        String?
  notes         String?
  createdAt     DateTime           @default(now())
  operationId   String? @unique
  operation     AccountOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  account       StoreCreditAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([saleId])
  @@map("store_credit_transactions")
}

model HouseAccount {
  id           String                    @id @default(uuid())
  customerId   String                    @unique
  creditLimit  Decimal @db.Decimal(14, 2)                     @default(0)
  balance      Decimal @db.Decimal(14, 2)                     @default(0) // amount the customer currently owes
  isActive     Boolean                   @default(true)
  locationId   String? // null = shared across all locations
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  customer     Customer                  @relation(fields: [customerId], references: [id])
  transactions HouseAccountTransaction[]
  operations   AccountOperation[]

  @@index([locationId])
  @@map("house_accounts")
}

model HouseAccountTransaction {
  id            String       @id @default(uuid())
  accountId     String
  type          String // CHARGE, PAYMENT, ADJUSTMENT
  amount        Decimal @db.Decimal(14, 2)
  balanceBefore Decimal @db.Decimal(14, 2)
  balanceAfter  Decimal @db.Decimal(14, 2)
  saleId        String?
  notes         String?
  userId        String?
  createdAt     DateTime     @default(now())
  operationId   String? @unique
  operation     AccountOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  account       HouseAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([saleId])
  @@map("house_account_transactions")
}

// Funding/repayment receipt facts. Old account transactions remain explicitly
// unlinked: their original funding tender or drawer cannot be inferred.
model AccountOperation {
  id                   String @id @default(uuid())
  idempotencyKey       String @unique
  requestHash          String
  kind                 String // GIFT_ISSUE, GIFT_RELOAD, STORE_CREDIT, HOUSE_PAYMENT
  paymentMethod        String // CASH, CARD, PROMOTIONAL, GOODWILL, CORRECTION
  amount               Decimal @db.Decimal(14, 2)
  balanceBefore        Decimal @db.Decimal(14, 2)
  balanceAfter         Decimal @db.Decimal(14, 2)
  reference            String?
  reason               String?
  userId               String
  locationId           String
  shiftId              String?
  giftCardId           String?
  storeCreditAccountId String?
  houseAccountId       String?
  createdAt            DateTime @default(now())
  user                 User @relation(fields: [userId], references: [id], onDelete: Restrict)
  location             Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shift                Shift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  giftCard             GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  storeCreditAccount   StoreCreditAccount? @relation(fields: [storeCreditAccountId], references: [id], onDelete: Restrict)
  houseAccount         HouseAccount? @relation(fields: [houseAccountId], references: [id], onDelete: Restrict)
  giftTransactions     GiftCardTransaction[]
  creditTransactions   StoreCreditTransaction[]
  houseTransactions    HouseAccountTransaction[]
  drawerEntries        DrawerEntry[]

  @@index([locationId, createdAt])
  @@index([giftCardId])
  @@index([storeCreditAccountId])
  @@index([houseAccountId])
  @@map("account_operations")
}

model Exchange {
  id              String   @id @default(uuid())
  exchangeNumber  String   @unique
  originalSaleId  String
  newSaleId       String?
  type            String // RETURN_ONLY, EXCHANGE, RETURN_FOR_CREDIT
  status          String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  reason          String
  returnedItems   Json // [{productId, quantity, price}]
  priceDifference Decimal @db.Decimal(14, 2)    @default(0)
  notes           String?
  processedBy     String
  locationId      String? // denormalized from the original sale's location
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([originalSaleId])
  @@index([exchangeNumber])
  @@index([locationId])
  @@map("exchanges")
}

model InventoryTransfer {
  id             String         @id @default(uuid())
  transferNumber String         @unique
  fromLocationId String
  toLocationId   String
  status         String         @default("PENDING") // PENDING, IN_TRANSIT, RECEIVED, CANCELLED
  notes          String?
  createdBy      String
  shippedAt      DateTime?
  receivedAt     DateTime?
  receivingHistoryKnown Boolean @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          TransferItem[]
  receipts       TransferReceipt[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@map("inventory_transfers")
}

model TransferItem {
  inventoryEntryId String? @unique
  dispatchedValue Decimal? @db.Decimal(24, 8)
  id          String            @id @default(uuid())
  transferId  String
  productId   String
  quantity    Int
  receivedQty Int               @default(0)
  damagedQty  Int               @default(0)
  missingQty  Int               @default(0)
  sentBackQty Int               @default(0)
  returnedQty Int               @default(0)
  returnDamagedQty Int           @default(0)
  returnMissingQty Int           @default(0)
  productSnapshot Json?
  destinationProductId String?
  destinationProduct Product? @relation("TransferDestination", fields: [destinationProductId], references: [id], onDelete: Restrict)
  receiptItems TransferReceiptItem[]
  createdAt   DateTime          @default(now())
  transfer    InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@index([destinationProductId])
  @@map("transfer_items")
}

model TransferReceipt {
  id String @id @default(uuid())
  transferId String
  kind String // RECEIVE, SOURCE_RETURN, REQUEST_RETURN
  idempotencyKey String
  requestHash String
  locationId String
  userId String
  notes String?
  createdAt DateTime @default(now())
  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  items TransferReceiptItem[]

  @@unique([transferId, idempotencyKey])
  @@index([transferId, createdAt])
  @@map("transfer_receipts")
}

model TransferReceiptItem {
  id String @id @default(uuid())
  receiptId String
  transferItemId String
  acceptedQty Int @default(0)
  damagedQty Int @default(0)
  missingQty Int @default(0)
  sentBackQty Int @default(0)
  receipt TransferReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  transferItem TransferItem @relation(fields: [transferItemId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([transferItemId])
  @@map("transfer_receipt_items")
}

model CycleCount {
  id          String           @id @default(uuid())
  countNumber String           @unique
  locationId  String
  status      String           @default("IN_PROGRESS") // IN_PROGRESS, REVIEW, APPROVED, CANCELLED
  type        String           @default("FULL") // FULL, PARTIAL, CATEGORY
  categoryId  String?
  notes       String?
  createdBy   String
  approvedBy  String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CycleCountItem[]

  @@index([locationId])
  @@index([status])
  @@map("cycle_counts")
}

model CycleCountItem {
  id           String     @id @default(uuid())
  cycleCountId String
  productId    String
  expectedQty  Int
  stockVersion Int?
  countedQty   Int?
  discrepancy  Int?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cycleCount   CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@index([cycleCountId])
  @@index([productId])
  @@map("cycle_count_items")
}

model Shift {
  hourlyRate        Decimal? @db.Decimal(14, 4)
  payrollFrequency  String?
  payrollTimezone   String?
  payrollEntries    PayrollEntry[]
  id                String         @id @default(uuid())
  userId            String
  locationId        String?
  clockInAt         DateTime
  clockOutAt        DateTime?
  startingCash      Decimal @db.Decimal(14, 2)          @default(0)
  endingCash        Decimal? @db.Decimal(14, 2)
  expectedCash      Decimal? @db.Decimal(14, 2)
  cashDifference    Decimal? @db.Decimal(14, 2)
  totalSales        Decimal @db.Decimal(14, 2)          @default(0)
  totalTransactions Int            @default(0)
  isClosed          Boolean        @default(false)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sales             Sale[]
  cashMovements     CashMovement[]
  drawerEntries     DrawerEntry[]
  accountOperations AccountOperation[]
  drawerHistoryComplete Boolean @default(true)
  location          Location?      @relation(fields: [locationId], references: [id])
  user              User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([locationId])
  @@index([clockInAt])
  @@map("shifts")
}

model CashMovement {
  id        String   @id @default(uuid())
  shiftId   String
  type      String // SAFE_DROP, PAID_IN, PAID_OUT
  amount    Decimal @db.Decimal(14, 2)
  reason    String
  userId    String
  idempotencyKey String? @unique
  drawerEntries DrawerEntry[]
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("cash_movements")
}

// Signed cash kept in or paid from a particular drawer. Entries are append-only.
// Starting cash remains on Shift; sale entries already subtract change.
model DrawerEntry {
  id             String   @id @default(uuid())
  sourceKey      String   @unique
  shiftId        String
  locationId     String?
  userId         String
  saleId         String?
  refundId       String?
  cashMovementId String?
  accountOperationId String?
  type           String // SALE, REFUND, VOID, PAID_IN, PAID_OUT, SAFE_DROP
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale           Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  refund         Refund?  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: Restrict)
  accountOperation AccountOperation? @relation(fields: [accountOperationId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([locationId, createdAt])
  @@map("drawer_entries")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  locationId String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Expense {
  inventoryReceiptId String?
  sourceType String @default("TRANSACTION")
  payrollEntries PayrollEntry[]
  id             String          @id @default(uuid())
  expenseNumber  String          @unique
  referenceKey   String?         @unique
  category       ExpenseCategory
  description    String
  amount         Decimal @db.Decimal(14, 2)
  status         ExpenseStatus   @default(PENDING)
  vendor         String?
  receiptUrl     String?
  invoiceNumber  String?
  expenseDate    DateTime        @default(now())
  dueDate        DateTime?
  paidDate       DateTime?
  locationId     String?
  userId         String
  approvedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  location       Location?       @relation(fields: [locationId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([status])
  @@index([expenseDate])
  @@index([locationId])
  @@index([userId])
  @@map("expenses")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique // SHA-256 of the key — the key itself is shown once
  prefix     String // first characters, for display ("pos_a1b2…")
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@map("api_keys")
}

model WebhookEndpoint {
  id             String    @id @default(uuid())
  url            String
  events         String[]  @default([]) // sale.completed, sale.refunded, product.low_stock
  secret         String // HMAC signing secret (whsec_…) — kept to sign payloads
  isActive       Boolean   @default(true)
  failCount      Int       @default(0) // consecutive failures; auto-disabled at 20
  lastStatus     Int?
  lastDeliveryAt DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  @@map("webhook_endpoints")
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  ACCEPTED
  FAILED
  REVIEW
  CANCELLED
}

model EmailDelivery {
  id             String              @id @default(uuid())
  locationId     String
  recipientId    String?
  recipientEmail String
  idempotencyKey String              @unique
  subject        String
  html           String
  status         EmailDeliveryStatus @default(QUEUED)
  attempts       Int                 @default(0)
  leaseToken     String?
  leaseExpiresAt DateTime?
  errorCode      String?
  acceptedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  location       Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  recipient      User?               @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([locationId, createdAt])
  @@map("email_deliveries")
}

model BackgroundJob {
  id             String @id @default(uuid())
  idempotencyKey String @unique
  kind           String
  status         String @default("QUEUED")
  locationId     String?
  requestedBy    String?
  label          String
  payload        String // encrypted; never returned by history APIs
  result         Json?
  attempts       Int @default(0)
  maxAttempts    Int @default(5)
  availableAt    DateTime @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastError      String?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  history        BackgroundJobAttempt[]

  @@index([status, availableAt, createdAt], map: "background_jobs_claim_idx")
  @@index([locationId, kind, createdAt], map: "background_jobs_scope_idx")
  @@map("background_jobs")
}

model BackgroundJobAttempt {
  id          String @id @default(uuid())
  jobId       String
  number      Int
  startedAt   DateTime
  finishedAt  DateTime @default(now())
  outcome     String
  code        String?
  job         BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, number])
  @@map("background_job_attempts")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Discount {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  type        String
  value       Decimal @db.Decimal(14, 4)
  minPurchase Decimal? @db.Decimal(14, 2)
  maxDiscount Decimal? @db.Decimal(14, 2)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  usageLimit  Int?
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("discounts")
}

model AgeVerificationLog {
  id           String    @id @default(uuid())
  saleId       String? // linked once the sale completes
  userId       String // cashier who performed the check
  locationId   String?
  minimumAge   Int // the strictest age requirement in the cart
  method       String // ID_SCAN, MANUAL_DOB, VISUAL
  birthDate    DateTime? // captured for ID_SCAN / MANUAL_DOB
  productNames String[]  @default([]) // restricted items in the cart at check time
  approved     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([saleId])
  @@map("age_verification_logs")
}

model Promotion {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        PromotionType
  isActive    Boolean       @default(true)
  // Rule parameters (which ones apply depends on `type`)
  buyQuantity Int? // QUANTITY_PRICE: units per bundle; BOGO: paid units
  getQuantity Int? // BOGO: discounted units per group
  bundlePrice Decimal? @db.Decimal(14, 4) // QUANTITY_PRICE: total price for buyQuantity units
  percentOff  Decimal? @db.Decimal(9, 4) // BOGO (default 100 = free) and PERCENT_OFF
  amountOff   Decimal? @db.Decimal(14, 4) // AMOUNT_OFF: $ off per unit
  // Targeting — a unit is eligible if its product OR category is listed (mix-and-match group)
  productIds  String[]      @default([])
  categoryIds String[]      @default([])
  // Schedule
  startsAt    DateTime?
  endsAt      DateTime?
  daysOfWeek  Int[]         @default([]) // 0=Sun..6=Sat, empty = every day
  startTime   String? // "HH:MM" store-local, with endTime enables happy-hour windows
  endTime     String?
  locationId  String? // null = all locations
  priority    Int           @default(0) // higher wins when units qualify for several promos
  timesUsed   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive])
  @@index([locationId])
  @@map("promotions")
}

model Budget {
  id         String          @id @default(uuid())
  category   ExpenseCategory
  amount     Decimal @db.Decimal(14, 2)
  period     BudgetPeriod    @default(MONTHLY)
  startDate  DateTime
  endDate    DateTime?
  locationId String?
  isActive   Boolean         @default(true)
  alertAt    Decimal? @db.Decimal(9, 4) // Alert when spending reaches this percentage (e.g., 80)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  location   Location?       @relation(fields: [locationId], references: [id])

  @@unique([category, period, startDate, locationId])
  @@index([category])
  @@index([locationId])
  @@map("budgets")
}

model RecurringExpense {
  id            String             @id @default(uuid())
  description   String
  category      ExpenseCategory
  amount        Decimal @db.Decimal(14, 2)
  vendor        String?
  frequency     RecurringFrequency
  dayOfMonth    Int? // For MONTHLY: which day (1-31)
  dayOfWeek     Int? // For WEEKLY: which day (0-6)
  startDate     DateTime
  endDate       DateTime?
  nextDueDate   DateTime
  locationId    String?
  userId        String
  isActive      Boolean            @default(true)
  lastGenerated DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  location      Location?          @relation(fields: [locationId], references: [id])
  user          User               @relation(fields: [userId], references: [id])

  @@index([nextDueDate])
  @@index([category])
  @@index([locationId])
  @@map("recurring_expenses")
}

model AccountingExport {
  id          String     @id @default(uuid())
  locationId  String?
  type        ExportType
  format      String // CSV, QBO, XLS
  startDate   DateTime
  endDate     DateTime
  status      String     @default("COMPLETED")
  fileUrl     String?
  recordCount Int        @default(0)
  userId      String
  createdAt   DateTime   @default(now())

  @@index([type])
  @@index([locationId, createdAt])
  @@index([createdAt])
  @@map("accounting_exports")
}

model ReceiptAttachment {
  id         String   @id @default(uuid())
  filename   String   @unique
  locationId String
  userId     String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([locationId])
  @@map("receipt_attachments")
}

model ManagerApproval {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  requestHash String
  cashierId   String
  managerId   String
  locationId  String
  action      String
  reason      String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([cashierId, expiresAt])
  @@map("manager_approvals")
}

enum CostStatus {
  VERIFIED
  ESTIMATED
  UNKNOWN
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  GIFT_CARD
  STORE_CREDIT
  EBT
  HOUSE_ACCOUNT
  OTHER
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
  VOIDED
  HOLD
}

enum ExpenseCategory {
  UTILITIES
  RENT
  PAYROLL
  SUPPLIES
  INVENTORY_PURCHASE
  MARKETING
  MAINTENANCE
  INSURANCE
  TAXES
  SHIPPING
  SOFTWARE
  EQUIPMENT
  OTHER
}

enum PromotionType {
  QUANTITY_PRICE // N for $X (2 for $6.00)
  BOGO // buy N get M at percentOff (100 = free)
  PERCENT_OFF // % off every eligible unit
  AMOUNT_OFF // $ off every eligible unit
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ExportType {
  SALES
  EXPENSES
  INVENTORY
  CUSTOMERS
  JOURNAL_ENTRIES
}

enum LotteryBatchStatus {
  ACTIVE
  DEPLETED
  RETURNED
}

enum LotteryTransactionStatus {
  OPEN
  CLOSED
}

model LotteryBatch {
  id               String              @id @default(uuid())
  batchNumber      String
  gameType         String
  startTicketNum   String
  endTicketNum     String
  totalTickets     Int
  remainingTickets Int
  pricePerTicket   Decimal @db.Decimal(14, 4)
  status           LotteryBatchStatus  @default(ACTIVE)
  activatedAt      DateTime?
  depletedAt       DateTime?
  notes            String?
  userId           String
  locationId       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id])
  location         Location?           @relation(fields: [locationId], references: [id])
  scans            LotteryTicketScan[]

  @@index([locationId])
  @@index([batchNumber])
  @@map("lottery_batches")
}

model LotteryTransaction {
  id                 String                   @id @default(uuid())
  transactionDate    DateTime
  onlineSalesCount   Int                      @default(0)
  onlineSalesAmount  Decimal @db.Decimal(14, 2)                    @default(0)
  offlineSalesCount  Int                      @default(0)
  offlineSalesAmount Decimal @db.Decimal(14, 2)                    @default(0)
  cashoutAmount      Decimal @db.Decimal(14, 2)                    @default(0)
  netAmount          Decimal @db.Decimal(14, 2)                    @default(0)
  status             LotteryTransactionStatus @default(OPEN)
  closedAt           DateTime?
  closedBy           String?
  notes              String?
  userId             String
  locationId         String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id])
  location           Location?                @relation(fields: [locationId], references: [id])
  scans              LotteryTicketScan[]

  @@unique([transactionDate, locationId], name: "transactionDate_locationId")
  @@index([locationId])
  @@index([transactionDate])
  @@map("lottery_transactions")
}

model LotteryTicketScan {
  id            String              @id @default(uuid())
  barcode       String
  ticketNumber  String?
  gameType      String?
  amount        Decimal? @db.Decimal(14, 2)
  notes         String?
  batchId       String?
  transactionId String?
  userId        String
  locationId    String?
  scannedAt     DateTime            @default(now())
  createdAt     DateTime            @default(now())
  batch         LotteryBatch?       @relation(fields: [batchId], references: [id])
  transaction   LotteryTransaction? @relation(fields: [transactionId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  location      Location?           @relation(fields: [locationId], references: [id])

  @@index([batchId])
  @@index([transactionId])
  @@index([locationId])
  @@index([scannedAt])
  @@map("lottery_ticket_scans")
}

model LotteryTicketType {
  id             String              @id @default(uuid())
  ticketName     String
  ticketCode     String
  pricePerTicket Decimal @db.Decimal(14, 4)
  sortOrder      Int                 @default(0)
  isActive       Boolean             @default(true)
  gameNumber     String?
  firstTicket    Int?
  lastTicket     Int?
  binNumber      String?
  startingNumber Int?
  countDirection String             @default("ASC")
  locationId     String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  location       Location            @relation(fields: [locationId], references: [id])
  dailyEntries   LotteryDailyEntry[]

  @@index([locationId])
  @@index([ticketCode])
  @@map("lottery_ticket_types")
}

// Store-day lottery accounting. Legacy lottery tables remain historical evidence.
model LotteryConfiguration {
  id String @id @default(uuid())
  locationId String
  effectiveDate String
  settings Json
  userId String
  createdAt DateTime @default(now())
  @@unique([locationId, effectiveDate])
  @@map("lottery_configurations")
}

model LotteryBook {
  id String @id @default(uuid())
  locationId String
  ticketTypeId String
  gameNumber String
  bookNumber String
  name String
  slot String
  direction String
  firstTicket Int
  lastTicket Int
  ticketCount Int
  price Decimal @db.Decimal(14, 2)
  position Int
  status String @default("ACTIVE")
  registeredDate String
  evidence String
  version Int @default(0)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([locationId, gameNumber, bookNumber])
  @@index([locationId, status])
  @@map("lottery_books")
}

model LotteryDay {
  id String @id @default(uuid())
  locationId String
  businessDate String
  recognizedAt DateTime
  configurationId String
  configuration Json
  report Json
  status String @default("DRAFT")
  version Int @default(0)
  totals Json?
  earningsIncomplete Boolean @default(true)
  closedBy String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([locationId, businessDate])
  @@index([locationId, recognizedAt])
  @@map("lottery_days")
}

model LotteryCheckpoint {
  id String @id @default(uuid())
  dayId String
  bookId String
  openingPosition Int
  closingPosition Int?
  openingVerified Boolean @default(false)
  previousStatus String
  disposition String @default("ACTIVE")
  lossQuantity Int @default(0)
  reason String?
  barcode String?
  slot String
  @@unique([dayId, bookId])
  @@map("lottery_checkpoints")
}

model LotterySettlement {
  id String @id @default(uuid())
  locationId String
  periodStart String
  periodEnd String
  reference String
  details Json
  reportedEarnings Decimal @db.Decimal(14, 2)
  version Int @default(1)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([locationId, periodStart, periodEnd])
  @@unique([locationId, reference])
  @@map("lottery_settlements")
}

model LotteryEarningPosting {
  id String @id @default(uuid())
  locationId String
  dayId String?
  settlementId String?
  sourceKey String @unique
  recognizedAt DateTime
  amount Decimal @db.Decimal(14, 2)
  reason String
  userId String
  createdAt DateTime @default(now())
  @@index([locationId, recognizedAt])
  @@index([dayId])
  @@index([settlementId])
  @@map("lottery_earning_postings")
}

model LotteryAuditEvent {
  id String @id @default(uuid())
  locationId String
  dayId String?
  action String
  details Json
  userId String
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
  @@map("lottery_audit_events")
}

model LotteryDailyEntry {
  id             String            @id @default(uuid())
  entryDate      DateTime
  ticketTypeId   String
  locationId     String
  startNumber    Int
  endNumber      Int
  pricePerTicket Decimal @db.Decimal(14, 4)
  ticketsSold    Int               @default(0)
  totalSales     Decimal @db.Decimal(14, 2)             @default(0)
  notes          String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  ticketType     LotteryTicketType @relation(fields: [ticketTypeId], references: [id])
  location       Location          @relation(fields: [locationId], references: [id])
  creator        User?             @relation("DailyEntryCreator", fields: [createdBy], references: [id])
  editor         User?             @relation("DailyEntryEditor", fields: [updatedBy], references: [id])

  @@index([entryDate])
  @@index([ticketTypeId])
  @@index([locationId])
  @@map("lottery_daily_entries")
}

model LotteryDayStatus {
  id                  String    @id @default(uuid())
  entryDate           DateTime
  locationId          String
  totalTicketsSold    Int       @default(0)
  totalSales          Decimal @db.Decimal(14, 2)     @default(0)
  manualCashoutAmount Decimal @db.Decimal(14, 2)     @default(0)
  netAmount           Decimal @db.Decimal(14, 2)     @default(0)
  status              String    @default("OPEN")
  isClosed            Boolean   @default(false)
  closedAt            DateTime?
  closedBy            String?
  reopenedAt          DateTime?
  reopenedBy          String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  location            Location  @relation(fields: [locationId], references: [id])
  closedByUser        User?     @relation("DayClosedBy", fields: [closedBy], references: [id])
  reopenedByUser      User?     @relation("DayReopenedBy", fields: [reopenedBy], references: [id])

  @@index([entryDate])
  @@index([locationId])
  @@map("lottery_day_statuses")
}

// Only a super-admin can link stores; links allow transfers in both directions.
model StoreConnection {
  id          String   @id @default(uuid())
  locationAId String
  locationBId String
  createdBy   String
  createdAt   DateTime @default(now())
  locationA   Location @relation("ConnectionA", fields: [locationAId], references: [id], onDelete: Cascade)
  locationB   Location @relation("ConnectionB", fields: [locationBId], references: [id], onDelete: Cascade)

  @@unique([locationAId, locationBId])
  @@map("store_connections")
}

// Snapshot of earned gross wages, split at store-local pay-period boundaries.
model PayrollEntry {
  id          String   @id @default(uuid())
  shiftId     String
  userId      String
  locationId  String
  periodStart DateTime
  periodEnd   DateTime
  seconds     Int
  hourlyRate  Decimal @db.Decimal(14, 4)
  grossPay    Decimal @db.Decimal(14, 2)
  expenseId   String?
  createdAt   DateTime @default(now())
  shift       Shift    @relation(fields: [shiftId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  location    Location @relation(fields: [locationId], references: [id])
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([shiftId, periodStart])
  @@index([locationId, periodEnd])
  @@map("payroll_entries")
}

/// A recorded quantity below zero that needs investigation. One unresolved
/// exception per product: openProductId is set while unresolved and cleared on
/// resolution, so the unique index allows exactly one open record.
model InventoryException {
  id String @id @default(uuid())
  productId String
  locationId String
  openProductId String? @unique
  status String @default("OPEN") // OPEN | RECOUNT_REQUESTED | RESOLVED
  firstNegativeAt DateTime @default(now())
  lastNegativeAt DateTime @default(now())
  triggerSaleId String?
  triggerEntryId String?
  lowestQuantity Int
  latestQuantity Int
  occurrenceCount Int @default(1)
  assignedToId String?
  recountRequestedAt DateTime?
  recountRequestedById String?
  countedQuantity Int?
  adjustmentEntryId String?
  resolution String?
  resolutionNotes String?
  resolvedById String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([locationId, status, lastNegativeAt])
  @@index([productId, createdAt])
  @@map("inventory_exceptions")
}

/// Manager correction of a sale line rung up under the wrong SKU. The sale and
/// its line stay unchanged; stock and cost move from one SKU to the other.
model SaleItemCorrection {
  id String @id @default(uuid())
  saleId String
  saleItemId String
  locationId String
  fromProductId String
  toProductId String
  quantity Int
  reason String
  notes String?
  userId String
  reverseEntryId String?
  applyEntryId String?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  @@index([saleItemId])
  @@index([locationId, createdAt])
  @@map("sale_item_corrections")
}

/// Units moved from one product to another because the wrong product was sold,
/// received or returned. The source loses units at its own cost; the target
/// gains them with that value, so a sale ends up carrying the cost of what
/// actually left the store. Revenue is never changed.
model StockReclass {
  id String @id @default(uuid())
  locationId String
  fromProductId String
  toProductId String
  quantity Int
  reason String // SOLD_AS_OTHER | RECEIVED_AS_OTHER | RETURNED_AS_OTHER
  exceptionId String?
  saleId String?
  saleItemId String?
  fromEntryId String
  toEntryId String
  cogsChange Decimal? @db.Decimal(24, 8)
  priceDifference Decimal? @db.Decimal(14, 2)
  notes String?
  userId String
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
  @@index([fromProductId])
  @@index([toProductId])
  @@map("stock_reclasses")
}

// A standalone product (e.g. "Marlboro Red Carton") turned into a pack of
// another product. Its stock moves over as base units at the same value, its
// barcode moves to the new pack, and the old product is archived.
model ProductPackMerge {
  id String @id @default(uuid())
  locationId String
  sourceProductId String
  baseProductId String
  sellingUnitId String
  sourceQuantity Int
  unitsPerPackage Int
  movedValue Decimal? @db.Decimal(24, 8)
  fromEntryId String?
  toEntryId String?
  userId String
  idempotencyKey String
  createdAt DateTime @default(now())
  @@unique([locationId, idempotencyKey])
  @@index([sourceProductId])
  @@index([baseProductId])
  @@map("product_pack_merges")
}

/// The actual supplier cost entered for stock that was added without an invoice.
/// The difference from the estimate posts once, in the period it is entered.
model UnmatchedCostMatch {
  id String @id @default(uuid())
  entryId String @unique
  locationId String
  productId String
  actualUnitCost Decimal @db.Decimal(14, 4)
  trueUpEntryId String
  notes String?
  userId String
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
  @@map("unmatched_cost_matches")
}

/// Contents of a variety pack. The pack is its own product (bought and sold
/// whole); opening one moves its units and value into the component products.
model ProductBundleComponent {
  id String @id @default(uuid())
  bundleProductId String
  componentProductId String
  locationId String
  // Units of this product in one pack. A pack's cost splits by count:
  // pack cost / units in the pack, times this quantity.
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bundle Product @relation("BundleContents", fields: [bundleProductId], references: [id], onDelete: Cascade)
  component Product @relation("BundleMembership", fields: [componentProductId], references: [id], onDelete: Restrict)
  @@unique([bundleProductId, componentProductId])
  @@index([componentProductId])
  @@map("product_bundle_components")
}

/// One opening of variety packs: the value that left the pack and where it went.
model BundleOpening {
  id String @id @default(uuid())
  locationId String
  bundleProductId String
  quantity Int
  bundleEntryId String
  value Decimal? @db.Decimal(24, 8)
  allocation Json
  userId String
  idempotencyKey String
  createdAt DateTime @default(now())
  @@unique([locationId, idempotencyKey])
  @@index([bundleProductId, createdAt])
  @@map("bundle_openings")
}

/// Target margin used to suggest prices. The most specific rule wins:
/// pack, product, brand, category, then the store default.
model PriceRule {
  id String @id @default(uuid())
  locationId String
  scope String // STORE | CATEGORY | BRAND | PRODUCT | SELLING_UNIT
  scopeId String @default("") // category id, brand, product id or pack id; empty for the store default
  targetMargin Decimal @db.Decimal(5, 4)
  minMargin Decimal? @db.Decimal(5, 4)
  rounding String @default("CENT") // CENT | NICKEL | NINE | NINETY_NINE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([locationId, scope, scopeId])
  @@map("price_rules")
}
