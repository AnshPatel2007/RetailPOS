# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# For Neon: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/pos_system

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS - Frontend URL(s)
# For multiple origins, separate with commas: https://app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@possystem.com

# Optional HTTPS email provider (takes precedence over SMTP)
SENDGRID_API_KEY=

# Optional global POS assistant (general help and authorized store analysis).
# Keep the provider key on the server. No provider request is made until a user sends a question.
ANTHROPIC_API_KEY=

# Product identity lookup: Open Food Facts plus UPCitemdb's free retail lookup.
# Optional paid UPCitemdb DEV/PRO key; never expose this key in the browser.
UPCITEMDB_API_KEY=
# Identify the application to catalog providers; set a real support contact for deployment.
PRODUCT_CATALOG_USER_AGENT=RetailPOS/1.0
# Optional additional commercial catalog. Empty means disabled; never expose this key in the browser.
# Review provider data/image usage terms before activation. This does not purchase a subscription.
BARCODELOOKUP_API_KEY=
BARCODELOOKUP_DAILY_LIMIT=250
BARCODELOOKUP_MONTHLY_LIMIT=5000

# Durable email/export/webhook jobs. Keep this key stable and back it up with
# deployment secrets; queued payloads cannot be decrypted after losing the key.
# At least 32 characters. Existing installations can initially use JWT_SECRET.
JOB_ENCRYPTION_KEY=replace-with-a-dedicated-stable-secret-at-least-32-characters
# Local development keeps outbound delivery disabled. Enable only after
# configuring the provider, reviewing queued jobs and validating the deployment.
BACKGROUND_WORKER_DISABLED=true
EMAIL_DELIVERY_WORKER_DISABLED=true
DAILY_DIGEST_DISABLED=true
BIRTHDAY_EMAILS_DISABLED=true
PAYROLL_SCHEDULER_DISABLED=true

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15
PASSWORD_RESET_EXPIRY=60
TWO_FACTOR_ISSUER=POS System

# App
APP_NAME=POS System
APP_URL=http://localhost:5173
